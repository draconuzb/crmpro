{
  "name": "crmpro",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "dev:api": "pnpm --filter @crmpro/api dev",
    "dev:web": "pnpm --filter @crmpro/web dev",
    "dev:bot": "pnpm --filter @crmpro/bot dev",
    "db:migrate": "pnpm --filter @crmpro/api prisma:migrate",
    "db:seed": "pnpm --filter @crmpro/api prisma:seed",
    "db:studio": "pnpm --filter @crmpro/api prisma:studio",
    "migrate:sqlite": "npx ts-node scripts/migrate-from-sqlite.ts"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.0",
    "prettier": "^3.2.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "bcrypt",
      "esbuild",
      "prisma"
    ]
  }
}
