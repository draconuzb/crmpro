# ═══════════════════════════════════════
# CRMPro — Environment Variables
# Copy this file: cp .env.example .env
# Then fill in real values
# ═══════════════════════════════════════

# ── PostgreSQL ──
POSTGRES_DB=crmpro
POSTGRES_USER=crmpro
POSTGRES_PASSWORD=CHANGE_ME_strong_password_here

# ── Redis ──
REDIS_PASSWORD=CHANGE_ME_redis_password_here

# ── JWT Secrets (generate with: openssl rand -hex 32) ──
JWT_SECRET=CHANGE_ME_jwt_secret_here
JWT_REFRESH_SECRET=CHANGE_ME_jwt_refresh_secret_here

# ── App Settings ──
NODE_ENV=production
APP_PORT=80
CORS_ORIGIN=http://your-domain.com

# ── Database URL ──
DATABASE_URL=postgresql://crmpro:CHANGE_ME_strong_password_here@localhost:5432/crmpro?schema=public

# ── Telegram Bot ──
TELEGRAM_BOT_TOKEN=CHANGE_ME_telegram_bot_token
BOT_SERVICE_PHONE=+998901234567
BOT_SERVICE_PASSWORD=CHANGE_ME_bot_service_password
BOT_PORT=3001

# ── AI (Google Gemini) ──
GEMINI_API_KEY=CHANGE_ME_gemini_api_key

# ── SMS (Eskiz.uz) ──
ESKIZ_API_KEY=CHANGE_ME_eskiz_api_key

# ── API Base URL (for bot -> api communication) ──
API_BASE_URL=http://localhost:3000
